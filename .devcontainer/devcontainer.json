{
  "name": "Soğuk Zincir Tekstil Çanta",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt && python calistir_hepsi.py",
  "postAttachCommand": {
    "panel": "python -m uvicorn panel.app:app --host 0.0.0.0 --port 8000"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Web paneli", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
